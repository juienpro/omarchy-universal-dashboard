      const variant2 = newVariant(RELEASE_SYNC, {
        wasmBinary: async () => {
          const buf = readFileSync(wasmPath);
          return buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength);
        }
      });
      return newQuickJSWASMModuleFromVariant(variant2);
    })();
  }
  return modulePromise;
}
function assertJsonSerializable(value) {
  if (value === void 0) {
    throw new Error("transform must return a value (got undefined)");
  }
  try {
    return JSON.parse(JSON.stringify(value));
  } catch {
    throw new Error("transform result is not JSON-serializable");
  }
}
async function runTransform(script, data) {
  const body = String(script || "");
  if (!body.trim()) {
    throw new Error("transform script is empty");
  }
  if (body.length > MAX_SCRIPT_CHARS) {
    throw new Error(`transform script too large (max ${MAX_SCRIPT_CHARS} chars)`);
  }
  const QuickJS = await getQuickModule();
  const dataJson = JSON.stringify(data);
  const code = `(function() {
"use strict";
var data = JSON.parse(${JSON.stringify(dataJson)});
return (function(data) {
${body}
})(data);
})()`;
  try {
    const result = QuickJS.evalCode(code, {
      shouldInterrupt: shouldInterruptAfterDeadline(Date.now() + TRANSFORM_TIMEOUT_MS),
      memoryLimitBytes: MEMORY_LIMIT_BYTES,
      maxStackSizeBytes: MAX_STACK_BYTES
    });
    return assertJsonSerializable(result);
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    if (message === "interrupted" || /interrupted/i.test(message)) {
      throw new Error(`transform timed out after ${TRANSFORM_TIMEOUT_MS}ms`);
    }
    throw new Error(`transform failed: ${message}`);
  }
}

// src/datasets.ts
var KEY_RE = /^[a-z][a-z0-9-]*$/;
var MIN_INTERVAL = 60;
var FETCH_TIMEOUT_MS = 2e4;
function isPersistedDatasetKey(key) {
  return KEY_RE.test(key) && !key.startsWith("_");
}
function isEphemeralDatasetKey(key) {
  return key.startsWith("_screen.") || key.startsWith("_url.");
}
function assertPersistedKey(key) {
  if (!isPersistedDatasetKey(key)) {
    throw new Error(
      `Invalid dataset key "${key}" \u2014 use a slug like orders-live (not _screen.* / _url.*)`
    );
  }
}
function readIndex() {
  ensureDirs();
  if (!existsSync(datasetsIndexPath())) return [];
  try {
    const raw = JSON.parse(readFileSync2(datasetsIndexPath(), "utf8"));
    return Array.isArray(raw.datasets) ? raw.datasets : [];
  } catch {
    return [];
  }
}
function writeIndex(datasets) {
  writeAtomic(datasetsIndexPath(), JSON.stringify({ datasets }, null, 2) + "\n");
}
function toMeta(rec) {
  return {
    key: rec.key,
    refreshIntervalSec: rec.refreshIntervalSec,
    fetchedAt: rec.fetchedAt,
    error: rec.error,
    nextRefreshAt: rec.nextRefreshAt,
    updatedAt: rec.updatedAt,
    hasData: rec.data !== void 0 && rec.data !== null
  };
}
function syncIndexEntry(rec) {
  const meta = toMeta(rec);
  const index = readIndex();
  const i = index.findIndex((d) => d.key === rec.key);
  if (i >= 0) index[i] = meta;
  else index.push(meta);
  writeIndex(index);
}
function listDatasets() {
  return readIndex().slice().sort((a, b) => a.key.localeCompare(b.key));
}
function getDataset(key) {
  assertPersistedKey(key);
  const path = datasetFilePath(key);
  if (!existsSync(path)) return null;
  try {
    return JSON.parse(readFileSync2(path, "utf8"));
  } catch {
    return null;
  }
}
function persistDataset(rec) {
  writeAtomic(datasetFilePath(rec.key), JSON.stringify(rec, null, 2) + "\n");
  syncIndexEntry(rec);
  return rec;
}
function parseSource(raw) {
  if (!raw || typeof raw !== "object") throw new Error("source is required");
  const obj = raw;
  const url = String(obj.url || "").trim();
  if (!url) throw new Error("source.url is required");
  let parsed;
  try {
    parsed = new URL(url);
  } catch {
    throw new Error(`Invalid source.url: ${url}`);
  }
  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
    throw new Error("source.url must be http(s)");
  }
  const headers = obj.headers && typeof obj.headers === "object" && !Array.isArray(obj.headers) ? Object.fromEntries(
    Object.entries(obj.headers).map(([k, v]) => [k, String(v)])
  ) : void 0;
  const jsonPath = obj.jsonPath !== void 0 && obj.jsonPath !== null && String(obj.jsonPath).trim() ? String(obj.jsonPath).trim() : void 0;
  return { url, headers, jsonPath };
}
function upsertDataset(input) {
  const key = String(input.key || "").trim().toLowerCase();
  assertPersistedKey(key);
  const source = parseSource(input.source);
  const refreshIntervalSec = Math.max(MIN_INTERVAL, Math.floor(input.refreshIntervalSec ?? 600));
  const existing = getDataset(key);
  const now = nowIso();
  let transform = existing?.transform;
  if (input.transform === null) transform = void 0;
  else if (typeof input.transform === "string") {
    const t = input.transform;
    if (t.length > 64e3) throw new Error("transform too large (max 64000 chars)");
    transform = t.trim() ? t : void 0;
  }
  const rec = {
    key,
    source,
    ...transform !== void 0 ? { transform } : {},
    refreshIntervalSec,
    data: existing?.data ?? null,
    fetchedAt: existing?.fetchedAt ?? null,
    error: existing?.error ?? null,
    nextRefreshAt: now,
    updatedAt: now
  };
  return persistDataset(rec);
}
function deleteDatasetFile(key) {
  assertPersistedKey(key);
  const path = datasetFilePath(key);
  if (existsSync(path)) unlinkSync(path);
  writeIndex(readIndex().filter((d) => d.key !== key));
}
function readPath(data, path) {
  if (!path) return data;
  const parts = path.split(".").filter(Boolean);
  let cur = data;
  for (const part of parts) {
    if (cur === null || cur === void 0) return void 0;
    if (Array.isArray(cur)) {
      const idx = Number(part);
      if (!Number.isInteger(idx)) return void 0;
      cur = cur[idx];
      continue;
    }
    if (typeof cur !== "object") return void 0;
    cur = cur[part];
  }
  return cur;
}
async function fetchJson(source) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
  try {
    const res = await fetch(source.url, {
      method: "GET",
      headers: {
        Accept: "application/json",
        ...source.headers || {}
      },
      signal: controller.signal
    });
    if (!res.ok) {
      throw new Error(`HTTP ${res.status} ${res.statusText}`);
    }
    const body = await res.json();
    const sliced = readPath(body, source.jsonPath);
    if (sliced === void 0) {
      throw new Error(`jsonPath "${source.jsonPath}" not found in response`);
    }
    return sliced;
  } finally {
    clearTimeout(timer);
  }
}
function nextRefreshIso(intervalSec, from = Date.now()) {
  return new Date(from + intervalSec * 1e3).toISOString();
}
function summarizeDataset(rec) {
  const data = Array.isArray(rec.data) ? { kind: "array", rows: rec.data.length, preview: rec.data.slice(0, 3), truncated: rec.data.length > 3 } : rec.data && typeof rec.data === "object" ? { kind: "object", preview: rec.data, truncated: false } : { kind: "other", preview: rec.data, truncated: false };
  const transform = rec.transform ? {
    chars: rec.transform.length,
    preview: rec.transform.length > 240 ? rec.transform.slice(0, 240) + "\u2026" : rec.transform
  } : null;
  return {
    key: rec.key,
    source: rec.source,
    transform,
    refreshIntervalSec: rec.refreshIntervalSec,
    fetchedAt: rec.fetchedAt,
    error: rec.error,
    nextRefreshAt: rec.nextRefreshAt,
    updatedAt: rec.updatedAt,
    data
  };
}
async function refreshDatasetRecord(key) {
  assertPersistedKey(key);
  const rec = getDataset(key);
  if (!rec) throw new Error(`Dataset not found: ${key}`);
  const now = nowIso();
  try {
    let data = await fetchJson(rec.source);
    if (rec.transform) {
      data = await runTransform(rec.transform, data);
    }
    const next = {
      ...rec,
      data,
      fetchedAt: now,
      error: null,
      nextRefreshAt: nextRefreshIso(rec.refreshIntervalSec),
      updatedAt: now
    };
    return persistDataset(next);
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    const next = {
      ...rec,
      error: message,
      nextRefreshAt: nextRefreshIso(rec.refreshIntervalSec),
      updatedAt: now
    };
    persistDataset(next);
    throw new Error(`Refresh failed for ${key}: ${message}`);
  }
}
async function refreshDueDatasetRecords() {
  ensureDirs();
  if (readIndex().length === 0 && existsSync(datasetsDir())) {
    for (const name of readdirSync(datasetsDir())) {
      if (!name.endsWith(".json")) continue;
      const key = name.slice(0, -5);
      if (!isPersistedDatasetKey(key)) continue;
      const rec = getDataset(key);
      if (rec) syncIndexEntry(rec);
    }
  }
  const now = Date.now();
  const refreshed = [];
  const failed = [];
  const skipped = [];
  for (const meta of listDatasets()) {
    const rec = getDataset(meta.key);
    if (!rec) continue;
    const due = !rec.nextRefreshAt || Number.isNaN(Date.parse(rec.nextRefreshAt)) || Date.parse(rec.nextRefreshAt) <= now;
    if (!due) {
      skipped.push(rec.key);
      continue;
    }
    try {
      refreshed.push(await refreshDatasetRecord(rec.key));
    } catch (err) {
      failed.push({
        key: rec.key,
        error: err instanceof Error ? err.message : String(err)
      });
    }
  }
  return { refreshed, failed, skipped };
}
function cacheForKeys(keys) {
  const out = {};
  for (const key of keys) {
    if (!isPersistedDatasetKey(key)) continue;
    const rec = getDataset(key);
    if (rec && rec.data !== void 0 && rec.data !== null) {
      out[key] = rec.data;
    }
  }
  return out;
}

// src/store.ts
var CAROUSEL_TRANSITIONS = ["fade", "slide", "scale"];
var MIN_CAROUSEL_INTERVAL_SEC = 3;
var MAX_CAROUSEL_INTERVAL_SEC = 600;
var DEFAULT_CAROUSEL_INTERVAL_SEC = 10;
function emptyCarousel() {
  return {
    enabled: false,
    viewIds: null,
    intervalSec: DEFAULT_CAROUSEL_INTERVAL_SEC,
    transition: "fade"
  };
}
function defaultLayout() {
  return normalizeScreenLayout({
    grid: normalizeGrid(),
    placements: {}
  });
}
function emptyScreen() {
  return {
    definition: null,
    inlineData: {},
    layout: defaultLayout(),
    activeViewId: null,
    updatedAt: nowIso()
  };
}
function boundDatasetKeys(definition) {
  if (!definition) return [];
  const keys = new Set(definition.datasets ?? []);
  for (const node of Object.values(definition.nodes)) {
    const props = node.props;
    const ds = props && typeof props.dataset === "string" ? props.dataset : null;
    if (ds) keys.add(ds);
  }
  return [...keys];
}
function hydrateScreenFromDatasets(state) {
  const ephemeral = {};
  for (const [k, v] of Object.entries(state.inlineData)) {
    if (isEphemeralDatasetKey(k)) ephemeral[k] = v;
  }
  const cached = cacheForKeys(boundDatasetKeys(state.definition));
  return { ...state, inlineData: { ...ephemeral, ...cached } };
}
function getScreen() {
  ensureDirs();
  if (!existsSync2(screenPath())) return emptyScreen();
  try {
    const raw = JSON.parse(readFileSync3(screenPath(), "utf8"));
    const state = {
      definition: raw.definition ?? null,
      inlineData: raw.inlineData ?? {},
      layout: normalizeScreenLayout(raw.layout ?? defaultLayout()),
      activeViewId: raw.activeViewId ?? null,
      updatedAt: raw.updatedAt ?? nowIso()
    };
    return hydrateScreenFromDatasets(state);
  } catch {
    return emptyScreen();
  }
}
function persistScreen(state) {
  const hydrated = hydrateScreenFromDatasets(state);
  const next = { ...hydrated, updatedAt: nowIso() };
  writeAtomic(screenPath(), JSON.stringify(next, null, 2) + "\n");
  return next;
}
function clearScreen() {
  const prev = getScreen();
  return persistScreen({
    ...emptyScreen(),
    layout: normalizeScreenLayout({
      grid: prev.layout.grid,
      placements: {},
      themeId: prev.layout.themeId
    })
  });
}
function buildNode(spec, childIds = []) {
  const layoutTypes = /* @__PURE__ */ new Set([
    "Stack",
    "Group",
    "Grid",
    "Container",
    "Panel",
    "ScrollArea",
    "Card",
    "HorizontalTiles",
    "Repeat"
  ]);
  const base = {
    type: spec.type,
    props: spec.props ?? {}
  };
  if (layoutTypes.has(spec.type) || childIds.length > 0) {
    base.children = childIds;
  }
  return irNode.parse(base);
}
function flattenWidgetTree(spec) {
  const nodes = {};
  const seen = /* @__PURE__ */ new Set();
  function walk(s) {
    if (seen.has(s.id)) {
      throw new Error(`Duplicate widget id in tree: ${s.id}`);
    }
    seen.add(s.id);
    const childIds = (s.children ?? []).map(walk);
    nodes[s.id] = buildNode(s, childIds);
    return s.id;
  }
  walk(spec);
  return nodes;
}
function collectSubtreeIds(nodes, rootId) {
  const out = /* @__PURE__ */ new Set();
  function walk(id) {
    if (out.has(id)) return;
    out.add(id);
    const n = nodes[id];
    if (n && "children" in n && Array.isArray(n.children)) {
      for (const c of n.children) walk(c);
    }
  }
  walk(rootId);
  return out;
}
function collectDatasetFromProps(props) {
  return typeof props.dataset === "string" ? props.dataset : null;
}
function applyInlineData(inlineData, spec) {
  if (spec.data === void 0) {
    return { inlineData, datasetKey: collectDatasetFromProps(spec.props ?? {}) };
  }
  const key = collectDatasetFromProps(spec.props ?? {}) ?? `_screen.${spec.id}`;
  if (!isEphemeralDatasetKey(key)) {
    throw new Error(
      `widget.data requires an ephemeral key (_screen.*). For live refresh use ud_datasets_upsert + props.dataset without data.`
    );
  }
  return { inlineData: { ...inlineData, [key]: spec.data }, datasetKey: key };
}
function collectBoundDatasets(nodes, inlineData, existing = []) {
  const bound = new Set(existing);
  for (const node of Object.values(nodes)) {
    const ds = collectDatasetFromProps(node.props);
    if (ds) bound.add(ds);
  }
  for (const key of Object.keys(inlineData)) {
    if (isEphemeralDatasetKey(key) || isPersistedDatasetKey(key)) bound.add(key);
  }
  return [...bound];
}
function parseScreenDefinition(partial, inlineData) {
  return parseViewIr({
    ...partial,
    datasets: collectBoundDatasets(partial.nodes, inlineData, partial.datasets ?? [])
  });
}
function showOnScreen(input) {
  const state = getScreen();
  const { inlineData, datasetKey: datasetKey2 } = applyInlineData(state.inlineData, input.widget);
  const props = { ...input.widget.props ?? {} };
  if (datasetKey2 && !props.dataset) props.dataset = datasetKey2;
  const boundKey = typeof props.dataset === "string" ? props.dataset : null;
  if (boundKey && isPersistedDatasetKey(boundKey) && !getDataset(boundKey)) {
    throw new Error(
      `Dataset "${boundKey}" not found. Call ud_datasets_upsert (+ ud_datasets_refresh) before binding Stat/Table/HorizontalTiles.`
    );
  }
  if ((input.widget.type === "HorizontalTiles" || input.widget.type === "Repeat") && !(input.widget.children && input.widget.children.length > 0)) {
    throw new Error(
      `HorizontalTiles "${input.widget.id}" needs children[] (template stamped per dataset row). Example: Stack with Icon+Text inside.`
    );
  }
  const treeNodes = flattenWidgetTree({ ...input.widget, props });
  const rootKids = state.definition && !input.replace ? "children" in state.definition.nodes[state.definition.root] ? state.definition.nodes[state.definition.root].children : [] : [];
  const placement = resolveShowPlacement(
    state.layout.grid,
    {
      column: input.column,
      index: input.index,
      colspan: input.colspan,
      align: input.align
    },
    { isFirst: !state.definition || !!input.replace || rootKids.length === 0 }
  );
  if (!state.definition || input.replace) {
    const definition2 = parseScreenDefinition(
      {
        irVersion: 1,
        title: "Screen",
        root: "screen-root",
        nodes: {
          "screen-root": { type: "Stack", props: { gap: "md" }, children: [input.widget.id] },
          ...treeNodes
        }
      },
      inlineData
    );
    return persistScreen({
      definition: definition2,
      inlineData,
      activeViewId: null,
      layout: normalizeScreenLayout({
        grid: state.layout.grid,
        placements: { [input.widget.id]: placement },
        themeId: state.layout.themeId
      }),
      updatedAt: state.updatedAt
    });
  }
  const root = state.definition.nodes[state.definition.root];
  if (!root || !("children" in root)) {
    throw new Error("Screen root cannot accept children");
  }
  const drop = state.definition.nodes[input.widget.id] ? collectSubtreeIds(state.definition.nodes, input.widget.id) : /* @__PURE__ */ new Set();
  const nodes = {};
  for (const [id, n] of Object.entries(state.definition.nodes)) {
    if (!drop.has(id)) nodes[id] = n;
  }
  Object.assign(nodes, treeNodes);
  const children = root.children.includes(input.widget.id) ? root.children : [...root.children, input.widget.id];
  nodes[state.definition.root] = { ...root, children };
  const definition = parseScreenDefinition({ ...state.definition, nodes }, inlineData);
  return persistScreen({
    definition,
    inlineData,
    activeViewId: state.activeViewId,
    layout: normalizeScreenLayout({
      grid: state.layout.grid,
      placements: { ...state.layout.placements, [input.widget.id]: placement },
      themeId: state.layout.themeId
    }),
    updatedAt: state.updatedAt
  });
}
function configureScreenGrid(input) {
  const state = getScreen();
  const grid = normalizeGrid({
    columns: input.columns ?? state.layout.grid.columns,
    visible: input.visible ?? state.layout.grid.visible
  });
  const placements = {};
  for (const [id, p] of Object.entries(state.layout.placements)) {
    try {
      assertPlacement(grid.columns, p, id);
      const colspan = Math.min(grid.columns, Math.max(1, p.colspan ?? 1));
      placements[id] = {
        ...p,
        colspan,
        column: p.column != null ? Math.min(p.column, grid.columns) : void 0
      };
    } catch {
      placements[id] = defaultPlacement(grid);
    }
  }
  return persistScreen({
    ...state,
    layout: normalizeScreenLayout({ grid, placements, themeId: state.layout.themeId })
  });
}
function readViewsIndex() {
  ensureDirs();
  if (!existsSync2(viewsIndexPath())) return [];
  try {
    const raw = JSON.parse(readFileSync3(viewsIndexPath(), "utf8"));
    return Array.isArray(raw.views) ? raw.views : [];
  } catch {
    return [];
  }
}
function writeViewsIndex(views) {
  writeAtomic(viewsIndexPath(), JSON.stringify({ views }, null, 2) + "\n");
}
function listViews() {
  return readViewsIndex();
}
function getView(id) {
  const path = viewFilePath(id);
  if (!existsSync2(path)) return null;
  try {
    return JSON.parse(readFileSync3(path, "utf8"));
  } catch {
    return null;
  }
}
function saveScreenAsView(input) {
  const state = getScreen();
  if (!state.definition) throw new Error("Nothing on screen to save");
  const slug = input.slug.trim().toLowerCase();
  if (!/^[a-z][a-z0-9-]*$/.test(slug)) throw new Error("Invalid slug");
  const index = readViewsIndex();
  const existing = index.find((v) => v.slug === slug);
  const id = existing?.id ?? randomUUID();
  const title = input.title?.trim() || state.definition.title || slug;
  const updatedAt = nowIso();
  const definition = title !== state.definition.title ? parseViewIr({ ...state.definition, title }) : state.definition;
  const saved = {
    id,
    slug,
    title,
    updatedAt,
    definition,
    layout: state.layout
  };
  writeAtomic(viewFilePath(id), JSON.stringify(saved, null, 2) + "\n");
  const nextIndex = existing ? index.map((v) => v.id === id ? { id, slug, title, updatedAt } : v) : [...index, { id, slug, title, updatedAt }];
  writeViewsIndex(nextIndex);
  persistScreen({
    ...state,
    definition,
    activeViewId: id,
    updatedAt
  });
  return saved;
}
function deleteView(id) {
  const view = getView(id);
  if (!view) throw new Error(`View not found: ${id}`);
  const path = viewFilePath(id);
  if (existsSync2(path)) unlinkSync2(path);
  writeViewsIndex(readViewsIndex().filter((v) => v.id !== id));
  const state = getScreen();
  if (state.activeViewId === id) {
    clearScreen();
    return { deleted: id, cleared: true };
  }
  return { deleted: id, cleared: false };
}
function loadViewOnScreen(id) {
  const view = getView(id);
  if (!view) throw new Error(`View not found: ${id}`);
  return persistScreen({
    definition: view.definition,
    inlineData: {},
    layout: normalizeScreenLayout(view.layout),
    activeViewId: view.id,
    updatedAt: nowIso()
  });
}
function summarizeScreen(state) {
  const inlineData = {};
  for (const [key, value] of Object.entries(state.inlineData)) {
    if (Array.isArray(value)) {
      inlineData[key] = { kind: "array", rows: value.length, preview: value.slice(0, 3), truncated: value.length > 3 };
    } else if (value && typeof value === "object") {
      inlineData[key] = { kind: "object", preview: value, truncated: false };
    } else {
      inlineData[key] = { kind: "other", preview: value, truncated: false };
    }
  }
  return {
    definition: state.definition,
    layout: state.layout,
    activeViewId: state.activeViewId,
    updatedAt: state.updatedAt,
    inlineData
  };
}
function syncDatasetIntoLiveScreen(key, data) {
  const state = getScreen();
  if (!state.definition) return;
  if (!boundDatasetKeys(state.definition).includes(key)) return;
  persistScreen({
    ...state,
    inlineData: { ...state.inlineData, [key]: data }
  });
}
async function refreshDataset(key) {
  const rec = await refreshDatasetRecord(key);
  syncDatasetIntoLiveScreen(key, rec.data);
  return rec;
}
async function refreshDueDatasets() {
  const result = await refreshDueDatasetRecords();
  for (const rec of result.refreshed) {
    syncDatasetIntoLiveScreen(rec.key, rec.data);
  }
  if (result.refreshed.length > 0) {
    const state = getScreen();
    if (state.definition) persistScreen(state);
  }
  return {
    refreshed: result.refreshed.map((r) => r.key),
    failed: result.failed,
    skipped: result.skipped
  };
}
function deleteDataset(key) {
  deleteDatasetFile(key);
  const state = getScreen();
  if (key in state.inlineData) {
    const inlineData = { ...state.inlineData };
    delete inlineData[key];
    persistScreen({ ...state, inlineData });
  }
  return { deleted: key };
}
function getCarousel() {
  ensureDirs();
  if (!existsSync2(carouselPath())) return emptyCarousel();
  try {
    const raw = JSON.parse(readFileSync3(carouselPath(), "utf8"));
    return normalizeCarousel(raw);
  } catch {
    return emptyCarousel();
  }
}
function normalizeCarousel(raw) {
  const base = emptyCarousel();
  if (!raw || typeof raw !== "object") return base;
  const transition = typeof raw.transition === "string" && CAROUSEL_TRANSITIONS.includes(raw.transition) ? raw.transition : base.transition;
  let viewIds = null;
  if (Array.isArray(raw.viewIds)) {
    const ids = raw.viewIds.map((id) => String(id)).filter(Boolean);
    viewIds = ids.length ? ids : null;
  }
  const intervalSec = typeof raw.intervalSec === "number" && Number.isFinite(raw.intervalSec) ? Math.min(MAX_CAROUSEL_INTERVAL_SEC, Math.max(MIN_CAROUSEL_INTERVAL_SEC, Math.floor(raw.intervalSec))) : base.intervalSec;
  return {
    enabled: !!raw.enabled,
    viewIds,
    intervalSec,
    transition
  };
}
function setCarousel(input) {
  const current = getCarousel();
  const index = readViewsIndex();
  const known = new Set(index.map((v) => v.id));
  let viewIds = current.viewIds;
  if (input.views !== void 0) {
    if (input.views === null || input.views.length === 0) {
      viewIds = null;
    } else {
      const missing = input.views.filter((id) => !known.has(id));
      if (missing.length) throw new Error(`Unknown view id(s): ${missing.join(", ")}`);
      viewIds = [...new Set(input.views.map(String))];
    }
  }
  if (input.enabled) {
    const pool = viewIds ? viewIds : index.map((v) => v.id);
    if (pool.length < 2) {
      throw new Error("Carousel needs at least 2 saved views (pass views: [id,\u2026] or save more views)");
    }
  }
  const next = normalizeCarousel({
    enabled: input.enabled,
    viewIds,
    intervalSec: input.intervalSec ?? current.intervalSec,
    transition: input.transition ?? current.transition
  });
  writeAtomic(carouselPath(), JSON.stringify(next, null, 2) + "\n");
  return next;
}
function toggleCarousel() {
  const current = getCarousel();
  return setCarousel({ enabled: !current.enabled });
}
function cycleCarouselTransition() {
  const current = getCarousel();
  const idx = CAROUSEL_TRANSITIONS.indexOf(current.transition);
  const next = CAROUSEL_TRANSITIONS[(idx + 1) % CAROUSEL_TRANSITIONS.length];
  return setCarousel({ enabled: current.enabled, transition: next });
}
function bumpCarouselInterval(deltaSec) {
  const current = getCarousel();
  const delta = Math.trunc(deltaSec);
  if (!delta) return current;
  return setCarousel({
    enabled: current.enabled,
    intervalSec: current.intervalSec + delta
  });
}

